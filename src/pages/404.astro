---
import Base from '../layouts/Base.astro';
import { identity, routes } from '../data/site';
---
<Base inner title={`Page not found | ${identity.fullName}`} description="This page could not be found.">
  <main id="content" class="page">
    <h1>Page not found</h1>
    <p class="lede">That address doesn't lead anywhere on this site.</p>
    <p><a class="text-link" href={routes.home}>Back to the homepage&nbsp;<span class="arrow" aria-hidden="true">↗</span></a></p>
  </main>
</Base>
