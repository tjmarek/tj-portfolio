---
import type { PreviewKind } from '../data/site';
interface Props { kind: PreviewKind; }
const { kind } = Astro.props;
// Abstract palette studies only. Deliberately not a chart, UI or client site.
---
<svg class="preview-art" viewBox="0 0 320 240" aria-hidden="true" focusable="false">
  <rect width="320" height="240" fill="#4A5B4E" />
  {kind === 'websites' && (
    <g>
      <rect x="28" y="28" width="168" height="120" rx="20" fill="#C2D1C2" />
      <rect x="84" y="64" width="208" height="148" rx="20" fill="#E5EBE5" />
      <rect x="108" y="88" width="72" height="72" rx="36" fill="#262626" />
      <rect x="196" y="88" width="72" height="30" rx="15" fill="#C2D1C2" />
      <rect x="196" y="130" width="72" height="30" rx="15" fill="#DD2713" />
    </g>
  )}
  {kind === 'search' && (
    <g>
      <rect x="28" y="36" width="264" height="40" rx="20" fill="#C2D1C2" />
      <rect x="68" y="88" width="224" height="40" rx="20" fill="#E5EBE5" />
      <rect x="132" y="140" width="160" height="64" rx="32" fill="#262626" />
      <circle cx="260" cy="172" r="20" fill="#DD2713" />
    </g>
  )}
  {kind === 'analytics' && (
    <g fill="none" stroke-width="28">
      <path d="M44 240a116 116 0 0 1 116-116" stroke="#C2D1C2" />
      <path d="M160 240a116 116 0 0 1 116-116" stroke="#E5EBE5" />
      <path d="M44 124A116 116 0 0 1 160 8" stroke="#262626" />
      <circle cx="248" cy="58" r="28" fill="#DD2713" stroke="none" />
    </g>
  )}
</svg>
