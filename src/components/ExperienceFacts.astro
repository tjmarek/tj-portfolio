---
import { copy, experienceEntries, resume } from '../data/site';
const e = copy.experience;
---
<div class="experience">
  <ul class="disciplines">
    {e.disciplines.map((d) => (
      <li><h3>{d.name}</h3><p>{d.detail}</p></li>
    ))}
  </ul>
  {experienceEntries.length > 0
    ? (
      <ul class="experience__entries">
        {experienceEntries.map((entry) => (
          <li>
            <h3>{entry.role}, {entry.employer}</h3>
            <p class="eyebrow">{entry.dates}</p>
            <p>{entry.scope}</p>
            <ul>{entry.results.map((r) => <li>{r}</li>)}</ul>
          </li>
        ))}
      </ul>
    )
    : (
      <div class="pending">
        <h3>{e.pendingHeading}</h3>
        <dl>
          {e.pendingFacts.map((fact) => <div><dt>{fact}</dt><dd>{e.pendingValue}</dd></div>)}
        </dl>
      </div>
    )}
  {resume.href
    ? <p><a class="text-link" href={resume.href}>{e.resumeLink}&nbsp;<span class="arrow" aria-hidden="true">↗</span></a></p>
    : <p class="experience__note">{e.resumeMissing}</p>}
</div>
